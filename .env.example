# ==============================================================================
# BusGo Environment Configuration Example
# Copy this file to .env and configure your actual local or production settings.
# ==============================================================================

# Server & Application Settings
PORT=8080
APP_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/busgo_db
DB_USERNAME=busgo_app
DB_PASSWORD=your_secure_password_here

# JWT Security Configuration (HMAC-SHA256 requires min 256 bits / 32 chars)
JWT_SECRET=BusGo_Production_Grade_Secret_Key_For_Jwt_Token_Validation_2026_Secure
JWT_EXPIRATION_MS=86400000

# Payment Gateway (Razorpay Sandbox / Test Mode)
# Leave empty or test keys to run in DEMO PAYMENT mode
PAYMENT_PROVIDER_MODE=DEMO
PAYMENT_PROVIDER_KEY=rzp_test_placeholder_key
PAYMENT_PROVIDER_SECRET=rzp_test_placeholder_secret
PAYMENT_CURRENCY=INR

# WhatsApp Business Cloud API Configuration
# When empty or WHATSAPP_PROVIDER_MODE=MOCK, the system runs in Mock WhatsApp Mode
WHATSAPP_PROVIDER_MODE=MOCK
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_NOTIFICATION_LEAD_MINUTES=10
